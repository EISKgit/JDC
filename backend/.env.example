# Copy to .env and adjust as needed. All values below have working defaults.

# SQLite by default — zero setup. Point this at a Postgres URL later without
# changing any application code.
DATABASE_URL=sqlite:///./ilc.db

# Used to sign JWT access tokens. Change this to a random string for anything
# beyond local development.
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Optional — leave blank to disable "Sign in with Google". Fill in to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI provider:
#   "mock"   (default) rule-based, needs no key, deterministic output
#   "groq"   free LLM API, get a key at https://console.groq.com/keys
#   "openai" OpenAI API
# With groq/openai, any failed or rate-limited call falls back to the rules.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
