# Copy to .env and adjust as needed. All values below have working defaults.

# SQLite by default — zero setup. Point this at a Postgres URL later without
# changing any application code.
DATABASE_URL=sqlite:///./ilc.db

# "development" (default) runs with the built-in SECRET_KEY and only warns.
# Any other value (e.g. "production") refuses to start without a strong one.
ENVIRONMENT=development

# Signs every login token: anyone who knows it can log in as any user. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The value below is public (it's in the code), so only use it locally.
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Where the React app runs; used for the Google sign-in return and reset-email links.
FRONTEND_URL=http://localhost:5173

# Optional — leave blank to disable "Sign in with Google". Fill in to enable it.
# In Google Cloud Console, add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI provider:
#   "mock"   (default) rule-based, needs no key, deterministic output
#   "groq"   free LLM API, get a key at https://console.groq.com/keys
#   "openai" OpenAI API
# With groq/openai, any failed or rate-limited call falls back to the rules.
# "Ask JDC" and day summaries (LangGraph + ChatGroq) need "groq"; otherwise they
# answer with search results / a rule-based summary.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Password-reset emails (optional). Without SMTP_HOST the reset link is written to
# the backend's console instead, which is enough for local use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JDC <no-reply@localhost>

# Requests per minute: login/sign-up/reset per IP address, AI features per user.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
